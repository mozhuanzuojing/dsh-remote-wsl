{
  "name": "dsh-remote-wsl",
  "version": "0.3.9",
  "private": true,
  "description": "Remote-WSL for the DeepSeek Harness: treat a WSL distro as a remote execution host — status, terminal, resident remote dsh agent (SDK), Web UI window, and desktop-version parity. The DSH desktop shell cannot attach to a remote host (its host is spawned locally), so this plugin is the honest equivalent: it drives the WSL side from the Windows host instead of pretending to be a remote-connection UI.",
  "icon": "./icon.svg",
  "author": "磨砖做镜 (mozhuanzuojing) <mozhuanzuojing2020@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozhuanzuojing/dsh-remote-wsl.git"
  },
  "homepage": "https://github.com/mozhuanzuojing/dsh-remote-wsl#readme",
  "bugs": {
    "url": "https://github.com/mozhuanzuojing/dsh-remote-wsl/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./client": "./client/index.js",
    "./icon": "./icon.svg",
    "./fs-provider": "./src/fs-provider.ts",
    "./search-tool": "./src/search-tool.ts",
    "./shell-provider": "./src/shell-provider.ts"
  },
  "files": [
    "src",
    "client",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "wsl",
    "remote",
    "plugin"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "node --experimental-strip-types scripts/check-syntax.ts",
    "hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "license": "MIT"
}
