#!/bin/sh
# pre-push：GitHub 远程推送前，确认**已配置的** git HTTP 代理真的可达。
#
# 为什么只检查"已配置的代理"：本机直连 github.com 的 443 不通，git 走 127.0.0.1:9910 的本地
# 代理（见 `git config --get http.https://github.com.proxy`）。别的机器/CI 上通常**没有**这条配置，
# 此时直接放行 —— 钩子不能把自己的环境假设强加给别人。
#
# 与历史版本的区别（2026-10-27 修复）：
#   · 不再依赖 `~/.agents/scripts/geph-github-route.ps1`（那个目录已弃用，且缺失时旧实现 "exit 0"
#     静默放行，等于门禁形同虚设）；
#   · 不再声称"本仓已设 core.hooksPath"（要么真设，要么别写）；安装见 README「开发」一节。
#
# 逃生口：SKIP_PROXY_CHECK=1 git push
# 退出码：0 放行；1 拦下（代理已配置但不可达，或探测工具缺失导致无法确认）。

remote_url="$2"

case "$remote_url" in
  *github.com*) ;;
  *) exit 0 ;;
esac

if [ "${SKIP_PROXY_CHECK:-}" = "1" ]; then
  echo "pre-push: SKIP_PROXY_CHECK=1，跳过代理检查"
  exit 0
fi

proxy="$(git config --get http.https://github.com.proxy 2>/dev/null || true)"
if [ -z "$proxy" ]; then
  echo "pre-push: 未配置 http.https://github.com.proxy（非本机代理环境）⇒ 放行"
  exit 0
fi

# 从 http://127.0.0.1:9910 里取出 host:port（也接受 socks5://）
authority="$(printf '%s' "$proxy" | sed -e 's#^[a-zA-Z0-9+.-]*://##' -e 's#/.*$##' -e 's#^.*@##')"
host="${authority%%:*}"
port="${authority##*:}"
if [ -z "$host" ] || [ -z "$port" ] || [ "$host" = "$port" ]; then
  echo "pre-push: 无法解析代理地址（$proxy）⇒ 拦下：请修正 git 代理配置，或 SKIP_PROXY_CHECK=1 git push"
  exit 1
fi

if ! command -v bash >/dev/null 2>&1; then
  echo "pre-push: 找不到 bash，无法探测代理（$proxy）⇒ 拦下：SKIP_PROXY_CHECK=1 git push 可绕过"
  exit 1
fi

if bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
  echo "pre-push: 代理可达（$host:$port）⇒ 放行"
  exit 0
fi

echo ""
echo "pre-push: 拦下 —— 代理 $host:$port 不可达（git 已配置它走 GitHub）。"
echo "  · 起代理后再推；或临时绕过：SKIP_PROXY_CHECK=1 git push"
echo "  · 查看配置：git config --get http.https://github.com.proxy"
exit 1
